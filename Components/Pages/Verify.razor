@page "/verify"
@page "/map"
@rendermode InteractiveServer
@using KalsadaWatchApp.Models
@using KalsadaWatchApp.Models.Enums
@using KalsadaWatchApp.Services
@using static KalsadaWatchApp.Services.ReportDisplay
@inject IJSRuntime JSRuntime
@inject HazardReportService Reports
@inject PersistentComponentState AppState
@implements IDisposable

<PageTitle>KalsadaWatch - Road Status Verification & Damage Heat Map</PageTitle>

<div class="min-h-screen font-sans bg-civic-bg text-civic-body antialiased flex flex-col scroll-smooth page-transition">
  <!-- Navigation Bar with Animated Indicator -->
  <header class="w-full sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-civic-border transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 lg:px-10 h-20 flex items-center justify-between">
      <a href="/?tab=home#top" class="flex items-center gap-3 group active:scale-95 transition-transform duration-200 cursor-pointer">
        <div class="w-10 h-10 rounded-xl bg-civic-light text-civic-primary flex items-center justify-center group-hover:bg-civic-primary group-hover:text-white transition-all duration-300 shadow-sm">
          <span class="material-symbols-outlined text-2xl">account_balance</span>
        </div>
        <div>
          <span class="text-xl font-bold tracking-tight text-civic-primary group-hover:text-civic-dark transition-colors">KalsadaWatch</span>
          <span class="block text-xs text-civic-muted -mt-0.5">Public Infrastructure Monitoring</span>
        </div>
      </a>

      <!-- Functional In-Page Nav Links with Animated Active Indicator -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        
        <!-- Home Tab -->
        <a href="/?tab=home#top" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Home
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Report Road Tab -->
        <a href="report" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Report Road
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- How It Works Tab -->
        <a href="/?tab=workflow#workflow" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          How It Works
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

        <!-- Road Damage Map Tab (ACTIVE) -->
        <a href="verify" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-primary font-semibold">
          Road Damage Map
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-full opacity-100 shadow-[0_1px_6px_rgba(37,99,235,0.4)]"></span>
        </a>

        <!-- Feedback Tab -->
        <a href="/?tab=feedback#citizen-feedback" 
           class="group relative pb-2 transition-all duration-200 cursor-pointer active:scale-95 text-civic-muted hover:text-civic-primary">
          Feedback
          <span class="absolute bottom-0 left-0 h-[2.5px] rounded-full bg-civic-primary transition-all duration-300 ease-out w-0 opacity-0 group-hover:w-full group-hover:opacity-40"></span>
        </a>

      </nav>

      <!-- Routing Buttons -->
      <div class="flex items-center gap-3">
        <a href="signin" class="text-sm font-semibold text-civic-primary px-4 py-2 hover:bg-civic-light/60 active:scale-95 rounded-full transition-all duration-200 cursor-pointer">Sign In</a>
        <a href="register" class="text-sm font-semibold text-white bg-civic-primary hover:bg-civic-dark active:scale-95 hover:shadow-md hover:-translate-y-0.5 px-5 py-2.5 rounded-full shadow-sm transition-all duration-200 cursor-pointer inline-flex items-center gap-1">Register</a>
      </div>
    </div>
  </header>

  <!-- Main Content Body -->
  <main class="flex-1 max-w-7xl mx-auto w-full px-6 lg:px-10 py-8">
    
    <!-- Top Hero Header & Public Works Counters -->
    <div class="mb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-civic-border">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-civic-light text-civic-primary text-xs font-semibold mb-3">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Live Public Works Transparency Hub
          </div>
          <h1 class="text-3xl sm:text-4xl font-bold text-civic-title tracking-tight">
            Road Status Verification & Hazard Heat Map
          </h1>
          <p class="text-sm sm:text-base text-civic-muted mt-2 max-w-2xl leading-relaxed">
            Verify whether reported municipal roadway hazards are currently under construction, completed by asphalt crews, or queued for engineering inspection.
          </p>
        </div>

        <!-- Live Status Metrics Badges -->
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-amber-50 border border-amber-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 animate-pulse"></span>
            <div>
              <div class="text-xs text-amber-700 font-medium">Under Construction</div>
              <div class="text-lg font-bold text-amber-900 leading-tight">@underConstructionCount Zones</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-emerald-50 border border-emerald-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <div>
              <div class="text-xs text-emerald-700 font-medium">Finished & Repaired</div>
              <div class="text-lg font-bold text-emerald-900 leading-tight">@finishedCount Roads</div>
            </div>
          </div>

          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-blue-50 border border-blue-200 shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
            <div>
              <div class="text-xs text-blue-700 font-medium">Under Inspection</div>
              <div class="text-lg font-bold text-blue-900 leading-tight">@underInspectionCount Queued</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Interactive Filters & Map View Controls -->
      <div class="mt-6 flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
        
        <!-- Search Input -->
        <div class="relative flex-1 max-w-md">
          <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-lg">search</span>
          @* Searches the database when you press Enter or leave the box, not on every keystroke. *@
          <input type="text"
                 @bind="searchQuery"
                 @bind:after="ReloadReportsAsync"
                 placeholder="Search by road name, landmark, or ID..."
                 class="w-full pl-10 pr-10 py-2.5 rounded-xl border border-civic-border bg-white text-sm text-civic-title placeholder:text-slate-400 focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 transition-all shadow-sm" />
          @if (!string.IsNullOrEmpty(searchQuery))
          {
            <button @onclick="ClearSearch" class="material-symbols-outlined absolute right-3 top-2.5 text-slate-400 hover:text-slate-600 text-lg">
              close
            </button>
          }
        </div>

        <!-- Filter Pill Group: Status -->
        <div class="flex flex-wrap items-center gap-2">
          <button @onclick='() => SetStatusFilter("All")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "All" ? "bg-civic-primary text-white shadow-sm" : "bg-white border border-civic-border text-civic-muted hover:text-civic-title hover:border-civic-primary/40")">
            All Statuses (@totalCount)
          </button>
          <button @onclick='() => SetStatusFilter("Under Construction")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Under Construction" ? "bg-amber-500 text-white shadow-sm" : "bg-white border border-civic-border text-amber-700 hover:bg-amber-50")">
            🟡 Under Construction (@underConstructionCount)
          </button>
          <button @onclick='() => SetStatusFilter("Finished")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Finished" ? "bg-emerald-600 text-white shadow-sm" : "bg-white border border-civic-border text-emerald-700 hover:bg-emerald-50")">
            🟢 Finished (@finishedCount)
          </button>
          <button @onclick='() => SetStatusFilter("Under Inspection")' 
                  class="px-4 py-2 rounded-xl text-xs font-semibold transition-all @(selectedStatus == "Under Inspection" ? "bg-blue-600 text-white shadow-sm" : "bg-white border border-civic-border text-blue-700 hover:bg-blue-50")">
            🔵 Inspection (@underInspectionCount)
          </button>
        </div>

        <!-- Secondary Controls: District & Sort -->
        <div class="flex items-center gap-3">
          <!-- District Dropdown -->
          <div class="relative">
            <select @bind="selectedDistrict" @bind:after="ReloadReportsAsync" class="px-3.5 pr-8 py-2 rounded-xl bg-white border border-civic-border text-xs font-semibold text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none cursor-pointer shadow-sm">
              <option value="All">All Districts</option>
              @foreach (var district in districts)
              {
                <option value="@district.Id">@district.Name</option>
              }
            </select>
            <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 text-base pointer-events-none">expand_more</span>
          </div>

          <!-- Sort Dropdown (Near area / Recently added) -->
          <div class="relative">
            <select @bind="selectedSort" @bind:after="ReloadReportsAsync" class="px-3.5 pr-8 py-2 rounded-xl bg-white border border-civic-border text-xs font-semibold text-civic-title focus:outline-none focus:border-civic-primary focus:ring-2 focus:ring-civic-primary/15 appearance-none cursor-pointer shadow-sm">
              <option value="recent">⚡ Recently Added</option>
              <option value="near">📍 Near City Center</option>
              <option value="priority">🚨 Highest Priority</option>
            </select>
            <span class="material-symbols-outlined absolute right-2.5 top-2 text-slate-400 text-base pointer-events-none">expand_more</span>
          </div>

          <!-- Heatmap Layer Toggle -->
          <button @onclick="ToggleHeatmap" 
                  class="px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all @(isHeatmapActive ? "bg-rose-500 text-white shadow-sm" : "bg-white border border-civic-border text-civic-title hover:bg-slate-50")"
                  title="Toggle Heat Map visualization showing high concentration of road damage">
            <span class="material-symbols-outlined text-sm">local_fire_department</span>
            <span>@(isHeatmapActive ? "Heat Map Active" : "Heat Map")</span>
          </button>
        </div>

      </div>
    </div>

    <!-- Main Grid: Interactive Map (Left/Top) & Filtered Report Cards (Right/Bottom) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Interactive Map Column (7 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <div class="bg-white p-4 rounded-3xl border border-civic-border shadow-[0_8px_30px_rgb(0,0,0,0.04)] relative">
          
          <!-- Map Top Floating Status Strip -->
          <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center gap-2 text-xs font-bold text-civic-title">
              <span class="material-symbols-outlined text-civic-primary text-base">map</span>
              <span>Civic Infrastructure GIS Map</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[11px] text-civic-muted bg-slate-100 px-2.5 py-1 rounded-full">
                Interactive Pan & Zoom Enabled
              </span>
              <button @onclick="ResetMapView" class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-civic-light text-civic-primary hover:bg-blue-200 transition-colors">
                Center Map
              </button>
            </div>
          </div>

          <!-- Leaflet Map Container -->
          <div id="verificationMap" class="w-full h-[540px] rounded-2xl overflow-hidden border border-slate-200 z-10"></div>

          <!-- Map Legend Bar Below -->
          <div class="mt-3.5 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3 text-[11px] text-civic-muted px-1">
            <div class="flex items-center gap-4">
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Under Construction
              </span>
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Finished & Paved
              </span>
              <span class="inline-flex items-center gap-1.5 font-medium">
                <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span> Under Inspection
              </span>
              @if (isHeatmapActive)
              {
                <span class="inline-flex items-center gap-1.5 font-medium text-rose-600 font-semibold">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span> Thermal Hazard Clusters
                </span>
              }
            </div>
            <span class="text-[11px] text-slate-400">Click any pin or card to inspect verification</span>
          </div>

        </div>
      </div>

      <!-- Reports List Column (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- List Header Bar -->
        <div class="flex items-center justify-between px-1">
          <h2 class="text-sm font-bold text-civic-title flex items-center gap-2">
            <span class="material-symbols-outlined text-base text-civic-primary">format_list_bulleted</span>
            <span>Reported Road Statuses</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-civic-light text-civic-primary font-bold">@FilteredReports.Count</span>
          </h2>
          <span class="text-xs text-civic-muted">Showing filtered public works dispatches</span>
        </div>

        <!-- Scrollable Report Cards List -->
        <div class="space-y-3.5 max-h-[600px] overflow-y-auto pr-1">
          @if (pageMessage is not null)
          {
            <div class="bg-emerald-50 rounded-2xl border border-emerald-200 p-4 text-xs text-emerald-800" role="status">@pageMessage</div>
          }
          @if (errorMessage is not null)
          {
            <div class="bg-red-50 rounded-2xl border border-red-200 p-5 text-xs text-red-800" role="alert">
              <strong class="block text-sm font-bold mb-1">Could not load road reports</strong>
              <span>@errorMessage</span>
            </div>
          }
          else if (isLoading && FilteredReports.Count == 0)
          {
            <div class="bg-white rounded-2xl border border-civic-border p-12 text-center text-xs text-civic-muted">
              Loading road reports…
            </div>
          }
          else if (FilteredReports.Count == 0)
          {
            <div class="bg-white rounded-2xl border border-civic-border p-12 text-center">
              <div class="w-12 h-12 rounded-full bg-civic-light text-civic-primary flex items-center justify-center mx-auto mb-3">
                <span class="material-symbols-outlined text-2xl">search_off</span>
              </div>
              <h3 class="text-sm font-bold text-civic-title">No Road Hazard Reports Found</h3>
              <p class="text-xs text-civic-muted mt-1 max-w-xs mx-auto">
                No reports matched your current filter criteria. Try resetting the status or district filter.
              </p>
              <button @onclick="ResetAllFilters" class="mt-4 px-4 py-2 rounded-xl text-xs font-semibold bg-civic-primary text-white hover:bg-civic-dark transition-colors">
                Reset All Filters
              </button>
            </div>
          }
          else
          {
            @foreach (var report in FilteredReports)
            {
              <div class="p-5 bg-white rounded-2xl border transition-all duration-200 @(selectedReport?.Id == report.Id ? "border-civic-primary ring-2 ring-civic-primary/20 shadow-md" : "border-civic-border hover:border-civic-primary/40 shadow-sm")">
                
                <!-- Card Header: Status Badge & ID -->
                <div class="flex items-center justify-between mb-2.5">
                  @if (report.Status == "Under Construction")
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
                      <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Under Construction
                    </span>
                  }
                  else if (report.Status == "Finished")
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
                      <span class="material-symbols-outlined text-xs">verified</span> Finished & Repaired (100%)
                    </span>
                  }
                  else
                  {
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-800 border border-blue-200">
                      <span class="w-2 h-2 rounded-full bg-blue-500"></span> Under Engineering Review
                    </span>
                  }

                  <span class="text-xs font-mono font-bold text-civic-muted bg-slate-100 px-2 py-0.5 rounded">
                    #@report.Id
                  </span>
                </div>

                <!-- Title & Location -->
                <h3 class="text-sm font-bold text-civic-title leading-snug">@report.Title</h3>
                <div class="flex items-center gap-1 text-xs text-civic-muted mt-1">
                  <span class="material-symbols-outlined text-sm text-slate-400">location_on</span>
                  <span>@report.Location</span>
                </div>

                <!-- Progress Bar (only when progress is known; crew progress tracking comes later) -->
                @if (report.ProgressPercent is not null)
                {
                <div class="mt-3.5 space-y-1">
                  <div class="flex items-center justify-between text-[11px]">
                    <span class="text-civic-muted font-medium">Asphalt Repair Progress</span>
                    <span class="font-bold @(report.Status == "Finished" ? "text-emerald-600" : report.Status == "Under Construction" ? "text-amber-600" : "text-blue-600")">
                      @report.ProgressPercent%
                    </span>
                  </div>
                  <div class="w-full h-2 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full rounded-full transition-all duration-500 @(report.Status == "Finished" ? "bg-emerald-500" : report.Status == "Under Construction" ? "bg-amber-500" : "bg-blue-500")"
                         style="width: @(report.ProgressPercent)%"></div>
                  </div>
                </div>
                }

                <!-- Meta Footer: Crew & Actions -->
                <div class="flex items-center justify-between pt-3 mt-3 border-t border-slate-100 text-xs">
                  <div class="text-[11px] text-civic-muted">
                    <span class="block font-medium text-slate-700">@report.Severity priority</span>
                    <span>@report.District &bull; @report.DateReported</span>
                  </div>

                  <div class="flex items-center gap-2">
                    <button @onclick="() => FocusMapOnReport(report)" 
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-civic-light text-civic-primary hover:bg-blue-200 transition-colors flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs">my_location</span>
                      <span>Map</span>
                    </button>
                    <button @onclick="() => OpenAuditModal(report)" 
                            class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-civic-title hover:bg-slate-200 transition-colors flex items-center gap-1">
                      <span class="material-symbols-outlined text-xs">verified_user</span>
                      <span>Verify</span>
                    </button>
                  </div>
                </div>

              </div>
            }
          }
        </div>

      </div>

    </div>

  </main>

  <!-- Interactive Public Works Verification Audit Modal -->
  @if (isModalOpen && selectedReport != null)
  {
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm animate-fade-in" @onclick="CloseAuditModal">
      <div class="bg-white rounded-3xl border border-civic-border max-w-lg w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-2xl space-y-6 relative" @onclick:stopPropagation>
        
        <!-- Modal Close Button -->
        <button @onclick="CloseAuditModal" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors">
          <span class="material-symbols-outlined text-lg">close</span>
        </button>

        <!-- Top Certificate Badge -->
        <div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-semibold mb-2">
            <span class="material-symbols-outlined text-sm">verified</span> Official Municipal Public Works Audit
          </div>
          <h2 class="text-xl sm:text-2xl font-bold text-civic-title">@selectedReport.Title</h2>
          <p class="text-xs text-civic-muted mt-1 flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">pin_drop</span> @selectedReport.Location &bull; @selectedReport.District
          </p>
        </div>

        <!-- Status & Timeline Box -->
        <div class="p-4 rounded-2xl bg-civic-bg border border-civic-border space-y-3">
          <div class="flex items-center justify-between text-xs">
            <span class="text-civic-muted">Current Civic Status</span>
            <span class="font-bold @(selectedReport.Status == "Finished" ? "text-emerald-700" : selectedReport.Status == "Under Construction" ? "text-amber-700" : "text-blue-700")">
              @(selectedReport.Status + (selectedReport.ProgressPercent is int percent ? $" ({percent}%)" : ""))
            </span>
          </div>
          @if (selectedReport.ProgressPercent is not null)
          {
          <div class="w-full h-2.5 rounded-full bg-slate-200 overflow-hidden">
            <div class="h-full rounded-full @(selectedReport.Status == "Finished" ? "bg-emerald-500" : selectedReport.Status == "Under Construction" ? "bg-amber-500" : "bg-blue-500")"
                 style="width: @(selectedReport.ProgressPercent)%"></div>
          </div>
          }
          <div class="flex items-center justify-between text-[11px] text-civic-muted pt-1">
            <span>Reported: @selectedReport.DateReported</span>
            <span>@(selectedReport.Status == "Finished" ? $"Completed: {selectedReport.CompletionDate}" : $"Target: {selectedReport.CompletionDate}")</span>
          </div>
        </div>

        <!-- Technical Field Inspection Specifications -->
        <div class="grid grid-cols-2 gap-3 text-xs">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Hazard Type</span>
            <strong class="text-civic-title font-semibold">@selectedReport.HazardType</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Hazard Severity Rating</span>
            <strong class="text-civic-title font-semibold">@selectedReport.Severity Priority</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Reported On</span>
            <strong class="text-civic-title font-semibold">@selectedReport.ReportedOn</strong>
          </div>
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
            <span class="block text-[11px] text-civic-muted mb-0.5">Ticket Reference ID</span>
            <strong class="font-mono text-civic-primary font-bold">#@selectedReport.Id</strong>
          </div>
        </div>

        <!-- Citizen Photos (files in Supabase Storage, listed in report_photos) -->
        @if (photosForReport is { Count: > 0 })
        {
          <div class="text-xs">
            <span class="block font-bold text-civic-title mb-2">Photos (@photosForReport.Count):</span>
            <div class="grid grid-cols-3 gap-2">
              @foreach (var photo in photosForReport)
              {
                <a href="@photo.ImageUrl" target="_blank" rel="noopener" title="Open full-size photo">
                  <img src="@photo.ImageUrl" alt="Photo of report #@selectedReport.Id" loading="lazy"
                       class="w-full h-24 object-cover rounded-xl border border-slate-200 hover:opacity-90 transition-opacity" />
                </a>
              }
            </div>
          </div>
        }

        <!-- Citizen Description (editable with "Edit details") -->
        @if (!string.IsNullOrWhiteSpace(selectedReport.Description))
        {
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
            <span class="block font-bold text-civic-title mb-1">Citizen Description:</span>
            <p class="text-civic-muted leading-relaxed">@selectedReport.Description</p>
          </div>
        }

        <!-- Field Engineer Notes -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
          <span class="block font-bold text-civic-title mb-1">Public Works Inspection Notes:</span>
          <p class="text-civic-muted leading-relaxed">
            @selectedReport.Notes
          </p>
        </div>

        <!-- Status History (read from the status_updates history table) -->
        <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
          <span class="block font-bold text-civic-title mb-2">Status History:</span>
          @if (historyError is not null)
          {
            <p class="text-red-700">Could not load the history: @historyError</p>
          }
          else if (history is null)
          {
            <p class="text-civic-muted">Loading history…</p>
          }
          else if (history.Count == 0)
          {
            <p class="text-civic-muted">No status changes recorded yet.</p>
          }
          else
          {
            <ol class="space-y-2 max-h-40 overflow-y-auto pr-1">
              @foreach (var entry in history)
              {
                <li class="flex gap-2">
                  <span class="w-2 h-2 mt-1 shrink-0 rounded-full bg-civic-primary"></span>
                  <div>
                    <span class="font-semibold text-civic-title">@StatusLabel(entry.Status)</span>
                    <span class="text-slate-400"> &bull; @FormatLocal(entry.UpdatedAt)</span>
                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                    {
                      <span class="block text-civic-muted">@entry.Note</span>
                    }
                  </div>
                </li>
              }
            </ol>
          }
        </div>

        <!-- Manage This Report: edit (status, details) and delete (withdraw) -->
        <div class="p-3.5 rounded-xl border border-civic-border text-xs space-y-3">
          <span class="block font-bold text-civic-title">Manage This Report:</span>

          @if (manageMode == ManageMode.None)
          {
            <div class="flex flex-wrap gap-2">
              @if (NextStatus(selectedReport.StatusValue) is ReportStatus next)
              {
                <button @onclick="() => StartManage(ManageMode.Status)" class="px-3.5 py-2 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold flex items-center gap-1">
                  <span class="material-symbols-outlined text-sm">arrow_forward</span> Move to @StatusLabel(next)
                </button>
              }
              <button @onclick="() => StartManage(ManageMode.Details)" class="px-3.5 py-2 rounded-full border border-slate-200 text-civic-title hover:bg-slate-50 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">edit</span> Edit details
              </button>
              <button @onclick="() => StartManage(ManageMode.Withdraw)" class="px-3.5 py-2 rounded-full border border-red-200 text-red-700 hover:bg-red-50 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">delete</span> Withdraw report
              </button>
            </div>
          }
          else if (manageMode == ManageMode.Status && NextStatus(selectedReport.StatusValue) is ReportStatus nextStatus)
          {
            <label class="block font-semibold text-civic-title">Note for the history (moving to @StatusLabel(nextStatus))</label>
            <textarea @bind="statusNote" @bind:event="oninput" rows="2" maxlength="500" placeholder="e.g. Crew dispatched with hotmix asphalt."
                      class="w-full px-3 py-2 rounded-xl border border-civic-border focus:outline-none focus:border-civic-primary"></textarea>
            <div class="flex gap-2">
              <button @onclick="ConfirmStatusChangeAsync" disabled="@actionSaving" class="px-3.5 py-2 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold disabled:opacity-50">
                @(actionSaving ? "Saving…" : $"Move to {StatusLabel(nextStatus)}")
              </button>
              <button @onclick="CancelManage" disabled="@actionSaving" class="px-3.5 py-2 rounded-full border border-slate-200 text-civic-muted font-semibold">Cancel</button>
            </div>
          }
          else if (manageMode == ManageMode.Details)
          {
            <label class="block font-semibold text-civic-title">Severity</label>
            <select @bind="editSeverity" class="w-full px-3 py-2 rounded-xl border border-civic-border bg-white focus:outline-none focus:border-civic-primary">
              <option value="@SeverityLevel.High">High Priority</option>
              <option value="@SeverityLevel.Medium">Medium Priority</option>
              <option value="@SeverityLevel.Low">Low Priority</option>
            </select>
            <label class="block font-semibold text-civic-title">Description</label>
            <textarea @bind="editDescription" @bind:event="oninput" rows="3" maxlength="1000"
                      class="w-full px-3 py-2 rounded-xl border border-civic-border focus:outline-none focus:border-civic-primary"></textarea>
            <div class="flex gap-2">
              <button @onclick="SaveDetailsAsync" disabled="@actionSaving" class="px-3.5 py-2 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold disabled:opacity-50">
                @(actionSaving ? "Saving…" : "Save changes")
              </button>
              <button @onclick="CancelManage" disabled="@actionSaving" class="px-3.5 py-2 rounded-full border border-slate-200 text-civic-muted font-semibold">Cancel</button>
            </div>
          }
          else if (manageMode == ManageMode.Withdraw)
          {
            <p class="text-red-800 bg-red-50 border border-red-200 rounded-xl px-3 py-2">
              Withdraw <strong class="font-mono">#@selectedReport.Id</strong>? It disappears from the map and the counts.
              The row stays in the database with a <span class="font-mono">deleted_at</span> date (soft delete).
            </p>
            <div class="flex gap-2">
              <button @onclick="ConfirmWithdrawAsync" disabled="@actionSaving" class="px-3.5 py-2 rounded-full bg-red-700 hover:bg-red-800 text-white font-semibold disabled:opacity-50">
                @(actionSaving ? "Withdrawing…" : "Yes, withdraw")
              </button>
              <button @onclick="CancelManage" disabled="@actionSaving" class="px-3.5 py-2 rounded-full border border-slate-200 text-civic-muted font-semibold">Cancel</button>
            </div>
          }

          @if (actionMessage is not null)
          {
            <p class="text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-xl px-3 py-2" role="status">@actionMessage</p>
          }
          @if (actionError is not null)
          {
            <p class="text-red-700" role="alert">@actionError</p>
          }
        </div>

        <!-- Modal Actions -->
        <div class="flex items-center gap-3 pt-2">
          <button @onclick="() => FocusMapFromModal(selectedReport)" class="flex-1 h-11 rounded-full bg-civic-primary hover:bg-civic-dark text-white font-semibold text-xs flex items-center justify-center gap-1.5 transition-colors shadow-sm">
            <span class="material-symbols-outlined text-sm">my_location</span> Center on Interactive Map
          </button>
          <button @onclick="CloseAuditModal" class="px-5 h-11 rounded-full border border-slate-200 text-civic-muted hover:text-civic-title font-semibold text-xs transition-colors">
            Close
          </button>
        </div>

      </div>
    </div>
  }

</div>

@code {
    // City center used by the "Near City Center" sort (the same point the map's Center button flies to).
    private const double CenterLat = 14.5995;
    private const double CenterLng = 120.9842;

    private string selectedStatus = "All";
    private string selectedDistrict = "All";
    private string selectedSort = "recent";
    private string searchQuery = "";
    private bool isHeatmapActive = false;
    private bool isModalOpen = false;
    private RoadReport? selectedReport;
    private List<StatusUpdate>? history;
    private string? historyError;
    private List<ReportPhoto>? photosForReport;

    private const string StateKey = "verify-page";
    private PersistingComponentStateSubscription persistSubscription;
    private PageData? initialData; // kept so the first load can be handed from prerendering to the live page

    private List<District> districts = new();
    private Dictionary<ReportStatus, int> statusCounts = new();
    private List<RoadReport> FilteredReports { get; set; } = new();
    private bool isLoading = true;
    private string? errorMessage;
    private bool isMapReady;
    private int loadVersion; // lets an older response that arrives late be ignored

    /// <summary>What a report card and a map pin show. Built from a HazardReport row.</summary>
    private class RoadReport
    {
        public long DbId { get; set; }
        public string Id { get; set; } = "";        // ticket number, e.g. "KW-8921"
        public string Title { get; set; } = "";
        public string Location { get; set; } = "";
        public string District { get; set; } = "";
        public string HazardType { get; set; } = "";
        public string Severity { get; set; } = "";  // "High", "Medium", "Low" (the heat map reads this)
        public string Status { get; set; } = "";    // "Under Construction", "Finished", "Under Inspection"
        public int? ProgressPercent { get; set; }   // only known for finished repairs until crews are tracked
        public string DateReported { get; set; } = "";  // e.g. "2 hours ago"
        public string ReportedOn { get; set; } = "";    // e.g. "Nov 19, 3:50 PM"
        public string CompletionDate { get; set; } = "";
        public double? Lat { get; set; }
        public double? Lng { get; set; }
        public double? DistanceFromCenterKm { get; set; }
        public string Notes { get; set; } = "";
        public string Description { get; set; } = "";     // the citizen's own words
        public ReportStatus StatusValue { get; set; }      // the database value, for the next-status button
        public SeverityLevel SeverityValue { get; set; }
    }

    private int underConstructionCount => CountOf(ReportStatus.UnderConstruction);
    private int finishedCount => CountOf(ReportStatus.Repaired);
    private int underInspectionCount => CountOf(ReportStatus.Submitted) + CountOf(ReportStatus.UnderInspection);
    private int totalCount => underConstructionCount + finishedCount + underInspectionCount;
    private int CountOf(ReportStatus status) => statusCounts.GetValueOrDefault(status);

    /// <summary>Everything the page needs on first load.</summary>
    private sealed class PageData
    {
        public List<District> Districts { get; set; } = new();
        public List<ReportStatusCount> Counts { get; set; } = new();
        public List<HazardReport> Reports { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        // The page is drawn twice: once on the server (prerendering) and once when it goes live.
        // The first pass saves its data here so the second pass does not query Supabase again.
        persistSubscription = AppState.RegisterOnPersisting(SaveInitialData);

        try
        {
            if (!AppState.TryTakeFromJson<PageData>(StateKey, out var data) || data is null)
            {
                // Three small requests, sent at the same time.
                var districtsTask = Reports.GetDistrictsAsync();
                var countsTask = Reports.GetStatusCountsAsync();
                var reportsTask = Reports.GetReportsAsync(HazardReportService.PublicStatuses, null, null, ReportSort.Newest);
                await Task.WhenAll(districtsTask, countsTask, reportsTask);
                data = new PageData { Districts = districtsTask.Result, Counts = countsTask.Result, Reports = reportsTask.Result };
            }

            initialData = data;
            districts = data.Districts;
            statusCounts = data.Counts.ToDictionary(row => row.Status, row => row.Total);
            FilteredReports = SortForDisplay(data.Reports.Select(ToRoadReport));
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task SaveInitialData()
    {
        if (initialData is not null)
            AppState.PersistAsJson(StateKey, initialData);
        return Task.CompletedTask;
    }

    public void Dispose() => persistSubscription.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("kalsadaMap.init", "verificationMap", MapJson());
            isMapReady = true;
        }
    }

    /// <summary>Asks the database again with the current filters. Called whenever a filter changes.</summary>
    private async Task ReloadReportsAsync()
    {
        var version = ++loadVersion;
        isLoading = true;
        errorMessage = null;

        try
        {
            var sort = selectedSort == "priority" ? ReportSort.HighestPriority : ReportSort.Newest;
            var rows = await Reports.GetReportsAsync(SelectedStatuses(), SelectedDistrictId(), searchQuery, sort);
            if (version != loadVersion) return;
            FilteredReports = SortForDisplay(rows.Select(ToRoadReport));
        }
        catch (Exception ex)
        {
            if (version != loadVersion) return;
            errorMessage = ex.Message;
            FilteredReports = new();
        }
        finally
        {
            if (version == loadVersion) isLoading = false;
        }

        await PushMapDataAsync();
    }

    private IReadOnlyCollection<ReportStatus> SelectedStatuses() => selectedStatus switch
    {
        "Under Construction" => new[] { ReportStatus.UnderConstruction },
        "Finished" => new[] { ReportStatus.Repaired },
        "Under Inspection" => new[] { ReportStatus.Submitted, ReportStatus.UnderInspection },
        _ => HazardReportService.PublicStatuses
    };

    private long? SelectedDistrictId() => long.TryParse(selectedDistrict, out var id) ? id : null;

    // "Near City Center" is worked out here from each report's coordinates.
    // The database already returned the rows filtered and in date or priority order.
    private List<RoadReport> SortForDisplay(IEnumerable<RoadReport> reports)
        => selectedSort == "near"
            ? reports.OrderBy(r => r.DistanceFromCenterKm ?? double.MaxValue).ToList()
            : reports.ToList();

    private async Task SetStatusFilter(string status)
    {
        selectedStatus = status;
        await ReloadReportsAsync();
    }

    private async Task ClearSearch()
    {
        searchQuery = "";
        await ReloadReportsAsync();
    }

    private async Task ToggleHeatmap()
    {
        isHeatmapActive = !isHeatmapActive;
        await PushMapDataAsync();
    }

    private async Task ResetAllFilters()
    {
        selectedStatus = "All";
        selectedDistrict = "All";
        selectedSort = "recent";
        searchQuery = "";
        await ReloadReportsAsync();
    }

    private async Task OpenAuditModal(RoadReport report)
    {
        selectedReport = report;
        isModalOpen = true;
        history = null;
        historyError = null;
        photosForReport = null;
        manageMode = ManageMode.None;
        actionError = null;
        actionMessage = null;

        try
        {
            // History and photos are fetched together, only when the popup opens.
            var historyTask = Reports.GetHistoryAsync(report.DbId);
            var photosTask = LoadPhotosAsync(report.DbId);
            await Task.WhenAll(historyTask, photosTask);
            if (selectedReport != report) return;
            history = historyTask.Result;
            photosForReport = photosTask.Result;
        }
        catch (Exception ex)
        {
            if (selectedReport != report) return;
            history = new();
            historyError = ex.Message;
        }
    }

    /// <summary>Photos are extra: if they fail to load, the popup still shows everything else.</summary>
    private async Task<List<ReportPhoto>> LoadPhotosAsync(long reportId)
    {
        try
        {
            return await Reports.GetPhotosAsync(reportId);
        }
        catch (Exception)
        {
            return new List<ReportPhoto>();
        }
    }

    private void CloseAuditModal()
    {
        isModalOpen = false;
        manageMode = ManageMode.None;
    }

    // ---- Edit and delete (the "Manage This Report" panel in the popup) ----

    private enum ManageMode { None, Status, Details, Withdraw }
    private ManageMode manageMode;
    private bool actionSaving;
    private string? actionError;
    private string? actionMessage;
    private string? pageMessage;          // shown above the list, e.g. after a withdraw
    private string statusNote = "";
    private string editSeverity = "";
    private string editDescription = "";

    private void StartManage(ManageMode mode)
    {
        if (selectedReport is null) return;
        manageMode = mode;
        actionError = null;
        actionMessage = null;
        statusNote = "";
        editSeverity = selectedReport.SeverityValue.ToString();
        editDescription = selectedReport.Description;
    }

    private void CancelManage()
    {
        manageMode = ManageMode.None;
        actionError = null;
    }

    /// <summary>Edit: one UPDATE request; the database trigger adds the history row.</summary>
    private async Task ConfirmStatusChangeAsync()
    {
        if (selectedReport is null || NextStatus(selectedReport.StatusValue) is not ReportStatus next) return;
        if (string.IsNullOrWhiteSpace(statusNote))
        {
            actionError = "Add a short note for the history, for example \"Crew dispatched\".";
            return;
        }

        var note = statusNote.Trim();
        await RunActionAsync(id => Reports.ChangeStatusAsync(id, next, note), $"Moved to {StatusLabel(next)}. The change was added to the history below.");
    }

    /// <summary>Edit: corrects the severity and the citizen's description.</summary>
    private async Task SaveDetailsAsync()
    {
        if (!Enum.TryParse<SeverityLevel>(editSeverity, out var level) || !Enum.IsDefined(level))
        {
            actionError = "Choose a severity.";
            return;
        }

        var description = editDescription.Trim();
        await RunActionAsync(id => Reports.UpdateDetailsAsync(id, level, description), "Details saved.");
    }

    /// <summary>Delete (soft): sets deleted_at, so the report leaves the map but stays in the table.</summary>
    private async Task ConfirmWithdrawAsync()
    {
        if (selectedReport is null) return;
        var ticket = selectedReport.Id;
        await RunActionAsync(id => Reports.WithdrawAsync(id), $"Report #{ticket} was withdrawn. Its row is still in Supabase with a deleted_at date.", closeAfter: true);
    }

    /// <summary>Saves one change, then reloads what it affects: the counts, the list and map, and the open popup.</summary>
    private async Task RunActionAsync(Func<long, Task> saveChange, string doneMessage, bool closeAfter = false)
    {
        if (selectedReport is null || actionSaving) return;
        var reportId = selectedReport.DbId;
        actionSaving = true;
        actionError = null;
        actionMessage = null;
        pageMessage = null;

        try
        {
            await saveChange(reportId);
        }
        catch (Exception ex)
        {
            actionError = $"The change was not saved: {ex.Message}";
            actionSaving = false;
            return;
        }

        try
        {
            var countsTask = Reports.GetStatusCountsAsync();
            var reportTask = Reports.GetReportAsync(reportId);
            var historyTask = Reports.GetHistoryAsync(reportId);
            await Task.WhenAll(countsTask, reportTask, historyTask);
            statusCounts = countsTask.Result.ToDictionary(row => row.Status, row => row.Total);
            await ReloadReportsAsync();

            manageMode = ManageMode.None;
            if (closeAfter || reportTask.Result is not HazardReport fresh)
            {
                CloseAuditModal();
                pageMessage = doneMessage;
            }
            else
            {
                selectedReport = ToRoadReport(fresh);
                history = historyTask.Result;
                actionMessage = doneMessage;
            }
        }
        catch (Exception ex)
        {
            actionError = $"Saved, but the page could not refresh: {ex.Message}";
        }
        finally
        {
            actionSaving = false;
        }
    }

    private async Task FocusMapFromModal(RoadReport report)
    {
        CloseAuditModal();
        await FocusMapOnReport(report);
    }

    private async Task FocusMapOnReport(RoadReport report)
    {
        selectedReport = report;
        if (report.Lat is double lat && report.Lng is double lng)
            await JSRuntime.InvokeVoidAsync("kalsadaMap.panToLocation", lat, lng, report.Title, report.Status, report.Id);
    }

    private async Task ResetMapView()
    {
        await JSRuntime.InvokeVoidAsync("kalsadaMap.resetView");
    }

    private async Task PushMapDataAsync()
    {
        if (!isMapReady) return;
        await JSRuntime.InvokeVoidAsync("kalsadaMap.updateData", MapJson(), isHeatmapActive);
    }

    private string MapJson() => System.Text.Json.JsonSerializer.Serialize(FilteredReports);

    private RoadReport ToRoadReport(HazardReport r) => new()
    {
        DbId = r.Id,
        Id = r.TicketNumber,
        Title = HazardLabel(r.HazardType),
        Location = r.LocationLandmark,
        District = districts.FirstOrDefault(d => d.Id == r.DistrictId)?.Name ?? "Unknown district",
        HazardType = HazardLabel(r.HazardType),
        Severity = r.Severity.ToString(),
        Status = MapStatus(r.Status),
        ProgressPercent = r.Status == ReportStatus.Repaired ? 100 : null,
        DateReported = TimeAgo(r.SubmittedAt),
        ReportedOn = FormatLocal(r.SubmittedAt),
        CompletionDate = r.Status switch
        {
            ReportStatus.Repaired when r.ResolvedAt is DateTime resolved => FormatLocal(resolved),
            ReportStatus.Submitted or ReportStatus.UnderInspection => $"inspection by {FormatLocal(r.InspectionDueAt)}",
            _ => "not scheduled yet"
        },
        Lat = r.Latitude,
        Lng = r.Longitude,
        DistanceFromCenterKm = r.Latitude is double lat && r.Longitude is double lng
            ? DistanceKm(lat, lng, CenterLat, CenterLng)
            : null,
        Notes = string.IsNullOrWhiteSpace(r.StatusNote) ? "No inspection notes yet." : r.StatusNote,
        Description = r.Description,
        StatusValue = r.Status,
        SeverityValue = r.Severity
    };

    /// <summary>Straight-line distance between two points on Earth, in kilometers.</summary>
    private static double DistanceKm(double lat1, double lng1, double lat2, double lng2)
    {
        const double earthRadiusKm = 6371;
        static double ToRadians(double degrees) => degrees * Math.PI / 180;

        var dLat = ToRadians(lat2 - lat1);
        var dLng = ToRadians(lng2 - lng1);
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(ToRadians(lat1)) * Math.Cos(ToRadians(lat2)) * Math.Sin(dLng / 2) * Math.Sin(dLng / 2);
        return 2 * earthRadiusKm * Math.Asin(Math.Sqrt(a));
    }
}
